# Secrets / user data — NEVER commit
.gobbonet-secret
*.secret
*.key

# Models and engine (way over GitHub's 100MB limit)
models/
llama.cpp/
llama/
*.gguf
*.exe
*.dll
*.zip
*.7z

# Runtime junk
logs/
*.log
cache/
temp/
tmp/
conversations/
# Runtime state — never commit
.gobbonet-state.json
.swap-status.json
.last-lan-ip
active-model.json
.llama-launch.cmd
.embed-launch.cmd

# Built binary
/gobbonet
/gobbonet.exe

# Release bundles from build-release.sh
/dist/

# Installer build artifacts. models.ini IS committed -- it is generated, but
# committing it means makensis works without running the generator first.
/installer/payload/
/installer/GobboNetSetup-*.exe

# Bundled llama.cpp for the installer payload (~300 MB, fetched by hand)
/vendor/

# Runtime state written next to the config on a portable install
/config.toml
/models/
/llama-server.log
/state.json
/.gobbonet-secret
