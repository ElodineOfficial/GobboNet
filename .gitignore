# Secrets / user data — NEVER commit
.gobbonet-secret
*.secret
*.key

# Models and engine (way over GitHub's 100MB limit)
models/
llama.cpp/
llama/
*.gguf
*.exe
*.dll
*.zip
*.7z

# Runtime junk
logs/
*.log
cache/
temp/
tmp/
conversations/
# Runtime state — never commit
.gobbonet-state.json
.swap-status.json
.last-lan-ip
active-model.json
.llama-launch.cmd
.embed-launch.cmd
# The web-UI port, chosen at install time. Per-machine, like the secret.
.gobbonet-port
# Generation job spool — holds model reply transcripts
# (written by fileserver.ps1 only; the Go server keeps job spools in memory,
# so the ignore is for the PowerShell server and stays needed either way)
.jobs/
# hardware-probe.ps1 writes these next to itself; they describe the machine
# that ran it and mean nothing on any other one.
hardware.json
hardware.ini

# Built binary
/gobbonet
/gobbonet.exe

# The staged frontend, assembled from the repo-root frontend by stage-web.sh and
# compiled into the binary by internal/webui. Generated, never committed -- the
# repo root is the single source of truth. .gitkeep IS committed, so that
# `go:embed all:assets` has a directory to embed in a fresh clone.
/internal/webui/assets/*
!/internal/webui/assets/.gitkeep

# Older layout: stage-web.sh used to produce this, and installs before 1.7.5
# shipped it beside the binary. Still ignored so an existing checkout does not
# suddenly start offering one up.
# Generated, never committed: a committed copy of chat.html + js/ + css/ goes
# stale the moment upstream touches one of the 40 files, and serves the stale
# copy without complaining.
/web/

# Release bundles from build-release.sh
/dist/

# Installer build artifacts. models.ini IS committed -- it is generated, but
# committing it means makensis works without running the generator first.
/installer/payload/
/installer/GobboNetSetup-*.exe

# Bundled llama.cpp for the installer payload. Fetched and hash-checked by
# build-installer.sh against the pin in /engine.sha256, the same one the deb
# and rpm builds read -- it used to be placed here by hand with no pin at all.
# NOT /vendor/ -- that path at the module root is reserved by the Go
# toolchain, and a non-Go directory there breaks `go build`.
/installer/vendor/

# Runtime state written next to the config on a portable install
/config.toml
/models/
/llama-server.log
/state.json
/.gobbonet-secret
/perf.toml

# installer-linux build artefacts
installer-linux/vendor/
installer-linux/stage/
installer-linux/dist/

# installer-fedora build artefacts. Same shape as the Debian ones above, and
# none of them were ignored -- a single build left an rpmbuild tree and a
# 100 MB vendored engine sitting in the working copy.
installer-fedora/rpmbuild/
installer-fedora/stage/
installer-fedora/vendor/
installer-fedora/dist/
/linux-amd64/gobbonet
