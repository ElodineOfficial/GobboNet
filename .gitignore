# Secrets / user data — NEVER commit
.gobbonet-secret
*.secret
*.key

# Models and engine (way over GitHub's 100MB limit)
models/
llama.cpp/
llama/
*.gguf
*.exe
*.dll
*.zip
*.7z

# Runtime junk
logs/
*.log
cache/
temp/
tmp/
conversations/
# Runtime state — never commit
.gobbonet-state.json
.swap-status.json
.last-lan-ip
active-model.json
.llama-launch.cmd
.embed-launch.cmd
# The web-UI port, chosen at install time. Per-machine, like the secret.
.gobbonet-port
# Generation job spool — holds model reply transcripts
# (written by fileserver.ps1 only; the Go server keeps job spools in memory,
# so the ignore is for the PowerShell server and stays needed either way)
.jobs/
# hardware-probe.ps1 writes these next to itself; they describe the machine
# that ran it and mean nothing on any other one.
hardware.json
hardware.ini

# Built binary
/gobbonet
/gobbonet.exe

# The staged frontend, assembled from the repo-root frontend by stage-web.sh and
# compiled into the binary by internal/webui. Generated, never committed -- the
# repo root is the single source of truth. .gitkeep IS committed, so that
# `go:embed all:assets` has a directory to embed in a fresh clone.
/internal/webui/assets/*
!/internal/webui/assets/.gitkeep

# Older layout: stage-web.sh used to produce this, and installs before 1.7.5
# shipped it beside the binary. Still ignored so an existing checkout does not
# suddenly start offering one up.
# Generated, never committed: a committed copy of chat.html + js/ + css/ goes
# stale the moment upstream touches one of the 40 files, and serves the stale
# copy without complaining.
/web/
# And the copy a running server writes beside itself so the page it serves can
# be read on disk (internal/webui Export). Running linux-amd64/gobbonet from a
# checkout -- tests/test-linux-onboarding.py does -- leaves one here; make-zip.sh
# deletes it, and it must never ride along in a commit.
/linux-amd64/web/

# Release bundles from build-release.sh
/dist/

# catalog/models.ini IS committed -- it is generated from launch.bat by
# catalog/gen-catalog.py, but committing it means every builder works without
# running the generator first. (installer/, the retired design, went in 1.7.9.)

# Release-only files. make-zip.sh writes them into the archive; they are not
# source, and committing them is how a stale 1.7.6 START-HERE.md and
# SHA256SUMS.txt sat at the root for two releases.
/NO-ENGINE-IN-THIS-ZIP.txt
/PATCH-README.txt
/SHA256SUMS.txt
/START-HERE.md

# installer-win/stage-payload.sh's output, and what makensis builds from it.
/staging/
/installer-win/GobboNetSetup-*.exe

# Runtime state written next to the config on a portable install
/config.toml
/models/
/llama-server.log
/state.json
/.gobbonet-secret
/perf.toml

# installer-linux build artefacts
installer-linux/vendor/
installer-linux/stage/
installer-linux/dist/
installer-linux/stage-appimage/

# installer-fedora build artefacts. Same shape as the Debian ones above, and
# none of them were ignored -- a single build left an rpmbuild tree and a
# 100 MB vendored engine sitting in the working copy.
installer-fedora/rpmbuild/
installer-fedora/stage/
installer-fedora/vendor/
installer-fedora/dist/
/linux-amd64/gobbonet

# Local authentication cookies
/j3.txt
/jar2.txt
*cookies*.txt

# Authentication-file backups
.gobbonet-secret.*

# Conversation history and backups, including portable subfolders
.gobbonet-state.json.*
state.json
state.json.*
state-*.json
state-*.json.*

# Encrypted-history keyrings and locks
state.keyring
state.keyring.*
.state.lock

# Local configuration and backups, including portable subfolders
config.toml
config.toml.*
perf.toml
perf.toml.*

# Temporary writes that may contain authentication or conversation data
.config.toml.*.tmp
.perf.toml.*.tmp
.state*.tmp

# Local setup, tuning, and machine-specific runtime files
.gobbonet-perf.json
setup-complete.json
.gobbonet-lan
.swap-in-progress
hardware.json.tmp
hardware.ini.tmp

# Local history migration receipt (1.7.6 hotfix, internal/state/legacy.go)
legacy-import.json
# launch.bat's "first-run setup not finished" mark (cmd/gobbonet/launch.go)
.gobbonet-setup-pending

# Bundled Linux engine binaries
/linux-amd64/llama-cpp/
