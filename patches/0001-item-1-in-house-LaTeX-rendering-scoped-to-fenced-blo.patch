+  eq(ctx.mathDecodeEntities('a &amp;&amp; b'), 'a && b', '&amp; decodes');
+  eq(ctx.mathDecodeEntities('&amp;lt;'), '&lt;', '&amp;lt; decodes ONCE, to literal "&lt;"');
