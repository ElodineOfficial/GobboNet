+                 `<span class="math-sup">${mathEmit(n.sup)}</span>` +
+                 `<span class="math-sub">${mathEmit(n.sub)}</span>` +
+               '</span>';
+      }
+      if (n.sup) return base + `<sup class="math-sup-i">${mathEmit(n.sup)}</sup>`;
