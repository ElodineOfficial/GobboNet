++/* ================================================================
++   MATH RENDERING
++
++   Layout for the in-house LaTeX renderer (js/18-utils.js). Fractions,
++   radicals and stacked operator limits are all done with inline-flex
++   rather than tables or absolute positioning, so they stay on the text
++   baseline and reflow with the message.
++
++   No font is shipped. KaTeX's typographic quality comes substantially
++   from bundling Computer Modern — roughly a megabyte, in artefacts that
++   also have to fit an NSIS installer and Linux packages. A system serif
++   is a visible step down and a deliberate one.
++================================================================ */
++
++.math-block {
++  background: var(--panel);
++  border: 1px solid var(--border);
++  border-radius: var(--radius);
++  margin: 12px 0;
++  overflow: hidden;
++}
++
++.math-rendered {
++  padding: 14px 16px;
++  overflow-x: auto;          /* long equations scroll rather than wrap mid-fraction */
++  font-family: var(--font-math, Georgia, 'Times New Roman', serif);
++  font-size: 1.15em;
++  line-height: 2.1;          /* room for stacked limits and accents */
++  color: var(--text);
++}
++
++/* Source view — hidden until the Source button is pressed. */
++.math-source {
++  display: none;
++  margin: 0;
++  padding: 14px 16px;
++  border-top: 1px solid var(--border);
++  background: var(--black);
++  overflow-x: auto;
++}
++.math-block.math-show-source .math-source { display: block; }
++.math-block.math-show-source .math-rendered { display: none; }
++
++/* ── Atoms ──────────────────────────────────────────────────────── */
++
++.math-var { font-style: italic; }                    /* single letters are variables */
++.math-fn,
++.math-text { font-style: normal; }
++.math-fn { margin-right: 0.15em; }
++.math-text { font-family: var(--font); font-size: 0.92em; }
++
++/* Approximate TeX spacing: relations and binary operators get air.
++   Real TeX varies the amount by class; this is one flat value. */
++.math-bin { margin: 0 0.22em; }
++
++.math-space { display: inline-block; }
++
++.math-unknown {
++  font-family: var(--font);
++  font-size: 0.9em;
++  color: var(--amber, var(--label));
++  background: rgba(255, 176, 0, 0.12);
++  border-radius: 3px;
++  padding: 0 3px;
++  font-style: normal;
++}
++
++/* ── Fractions ──────────────────────────────────────────────────── */
++
++.math-frac {
++  display: inline-flex;
++  flex-direction: column;
++  vertical-align: -0.55em;    /* sits the bar near the baseline */
++  text-align: center;
++  margin: 0 0.15em;
++  font-size: 0.95em;
++}
++.math-num {
++  border-bottom: 1px solid currentColor;
++  padding: 0 0.35em 0.1em;
++  line-height: 1.35;
++}
++.math-den {
++  padding: 0.1em 0.35em 0;
++  line-height: 1.35;
++}
++
++.math-binom { display: inline-flex; align-items: center; }
++.math-binom-stack {
++  display: inline-flex;
++  flex-direction: column;
++  text-align: center;
++  padding: 0 0.2em;
++  line-height: 1.25;
++  font-size: 0.95em;
++}
++
++/* ── Radicals ───────────────────────────────────────────────────── */
++
++.math-sqrt { display: inline-flex; align-items: flex-start; margin: 0 0.1em; }
++.math-radical { font-size: 1.15em; line-height: 1; }
++.math-radicand {
++  border-top: 1px solid currentColor;
++  padding: 0.12em 0.25em 0 0.15em;
++  margin-top: 0.12em;
++}
++.math-root {
++  font-size: 0.65em;
++  align-self: flex-start;
++  margin-right: -0.45em;      /* tucks the index into the radical's crook */
++  margin-top: 0.1em;
++}
++
++/* ── Scripts ────────────────────────────────────────────────────── */
++
++.math-sup-i, .math-sub-i { font-size: 0.72em; }
++
++/* Both scripts on one base: stacked, not sequential. */
++.math-subsup {
++  display: inline-flex;
++  flex-direction: column;
++  vertical-align: -0.35em;
++  font-size: 0.72em;
++  line-height: 1.15;
++  text-align: left;
++  margin-left: 0.05em;
++}
++
++/* ── Big operators ──────────────────────────────────────────────── */
++
++.math-bigop { font-size: 1.45em; line-height: 1; }
++
++.math-limits {
++  display: inline-flex;
++  flex-direction: column;
++  align-items: center;
++  vertical-align: -0.5em;
++  margin: 0 0.2em;
++}
++.math-limits .math-upper,
++.math-limits .math-lower {
++  font-size: 0.62em;
++  line-height: 1.2;
++}
++.math-limits .math-upper:empty,
++.math-limits .math-lower:empty { display: none; }
++
++/* ── Accents ────────────────────────────────────────────────────── */
++
++.math-accent {
++  display: inline-flex;
++  flex-direction: column;
++  align-items: center;
++  vertical-align: -0.15em;
++}
++.math-accent .math-mark {
++  font-size: 0.8em;
++  line-height: 0.6;
++  height: 0.5em;
++}
++.math-accent .math-acc-base { line-height: 1.1; }
++
++/* ── Alphabets ──────────────────────────────────────────────────── */
++
++.math-f-cal  { font-family: 'Segoe Script', 'Apple Chancery', cursive; font-style: normal; }
++.math-f-bb   { font-weight: 600; letter-spacing: 0.03em; }
++.math-f-bf   { font-weight: 700; font-style: normal; }
++.math-f-rm   { font-style: normal; }
++.math-f-it   { font-style: italic; }
++.math-f-sf   { font-family: var(--font); font-style: normal; }
++.math-f-tt   { font-family: var(--font-mono, monospace); font-style: normal; }
++.math-f-frak { font-family: 'UnifrakturMaguntia', 'Luminari', fantasy; font-style: normal; }
++.math-f-cal .math-var,
++.math-f-bb .math-var,
++.math-f-bf .math-var,
++.math-f-rm .math-var,
++.math-f-sf .math-var,
++.math-f-tt .math-var,
++.math-f-frak .math-var { font-style: inherit; font-weight: inherit; }
